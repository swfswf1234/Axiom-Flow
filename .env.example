# Axiom-Flow .env 模板（复制为 .env；空值 = 未配置，服务降级运行）
# 本服务只做「模型 API 调用 + 预处理/后处理」：模型生命周期与调参归 QED-Engine（8900），
# 本仓库只连接模型服务。公共键（QED_DATA_ROOT / QED_DB_*）缺省经向上走查继承根 .env，
# 本文件足以独立部署（2026-09-17 配置简化设计，PLAN-002）。

# ============ 一、服务 ============
# 本服务监听端口
AXIOM_PORT=8902

# ============ 二、数据与数据库 ============
# 三项目统一数据根：raw/ 只读输入（QED-Tracker 写入）、parsed/ 本仓库产物
QED_DATA_ROOT=D:\coding\QED-Engine\dataset
QED_DB_HOST=127.0.0.1
QED_DB_PORT=3306
# 本地独立部署用 qed；由 QED-Engine 启动时经向上走查跟随根 .env
QED_DB_NAME=qed
QED_DB_USER=root
# 密钥类：只存 .env，勿入库/日志/提交
QED_DB_PASSWORD=

# ============ 三、解析引擎（本地模型服务，8900 托管生命周期）============
# 解析引擎：mineru | paddleocr-vl | qwen-vl（后两者预留）
AXIOM_OCR_ENGINE=mineru
# 图像槽位本地端点（MinerU 容器，健康端点 /health）
QED_OCR_MODEL_URL=http://127.0.0.1:5002
# 单次解析调用超时秒数（整本解析耗时长）
AXIOM_OCR_TIMEOUT=600

# 预留：qwen-vl 云端档位引擎（启用时取消注释；解析默认仍为 MinerU）
# API_KEY=
# AXIOM_VISION_MODEL=qwen-vl-plus
