# Axiom-Flow .env 模板（复制为 .env；空值 = 未配置，服务降级运行）
# 配置中心四段式对齐 QED-Engine 根 .env（2026-09-17，根仓库 PLAN-046 / REQ-075）
# 独立部署：本文件足以启动本服务；由 QED-Engine 启动时经向上走查跟随根 .env 兜底。

# ============ 一、全局配置 ============
QED_API_SELECT=local
QED_LLM_GATEWAY_URL=http://127.0.0.1:8900
QED_LLM_TIMEOUT=300
QED_DATA_ROOT=D:\coding\QED-Engine\dataset
QED_PROXY=http://127.0.0.1:7890

# ============ 二、API 调用配置 ============
QED_API_PROVIDER=qwen              # 厂商：qwen | deepseek | glm
API_KEY=                           # 唯一供应商密钥（云端档位）
QED_MODEL=qwen-plus                # 文字槽位身份
QED_OCR_MODEL=qwen-vl-plus         # 图像槽位身份
QED_EMBEDDING_MODEL=text-embedding-v4  # 向量槽位身份

# ============ 三、本地模型 / 解析引擎（本仓库解析直连）============
AXIOM_OCR_ENGINE=mineru            # 解析引擎：mineru | paddleocr-vl | qwen-vl
QED_OCR_MODEL_URL=http://127.0.0.1:5002   # 图像槽位本地端点（MinerU 容器，/health）
# AXIOM_PADDLEOCR_URL=             # PaddleOCR-VL 服务地址（预留）
AXIOM_VISION_MODEL=qwen-vl-plus    # qwen-vl 档位模型名（预留引擎）
AXIOM_PORT=8902                    # 本服务监听端口

# ============ 四、元数据库配置（MySQL 8，qed 库 af_* 表）============
QED_DB_HOST=127.0.0.1
QED_DB_PORT=3306
QED_DB_NAME=qed
QED_DB_USER=root
QED_DB_PASSWORD=
