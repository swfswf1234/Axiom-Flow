# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Environment
.env
.ev
venv/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
# Qoder 工作区：技能正本（L2 四件套）与权限边界入库，其余（缓存、本机面）继续忽略。
# 目录模式必须写成内容模式，否则被排除目录的子项无法重新纳入（2026-10-20 三仓统一，REQ-124 形态②）。
.qoder/*
!.qoder/skills/
!.qoder/settings.json

# Project data
data/
logs/

# Scratch：仓库根 tmp/ 是唯一临时区（临时脚本、真机窗口证据与留档、D 类备份）
# 区内内容不重要、可随手清理，故一律不入库（ADR 0012）。
/tmp/
/tmp-*/

# Config (contains secrets)
setting.ini

# macOS
.DS_Store

# Windows
Thumbs.db

# Test
.pytest_cache/
.ruff_cache/
.coverage
coverage-*.xml
htmlcov/
